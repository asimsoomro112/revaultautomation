# DM-to-Post Automation Bot — @therevaultofficial (ReVault preloved marketplace)
# Secrets ONLY via environment variables. Never commit real values.

# --- Meta / Instagram Platform (Instagram API with Instagram Login) ---
IG_API_VERSION=v26.0
IG_API_BASE=https://graph.instagram.com
IG_APP_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=            # your webhook verify token (you choose, paste in Meta dashboard too)
IG_USER_ID=                 # professional account's IG user id (numeric)

# --- Token encryption (AES-256-GCM, 32-byte hex string; generate: openssl rand -hex 32) ---
IG_TOKEN_ENC_KEY=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Firebase Admin SDK (service account of the NEW Firebase project) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=       # \n-escaped private key

# --- Upstash QStash ---
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Admin allowlist (comma-separated Google emails) ---
ADMIN_EMAILS=

# --- Vercel Cron (Vercel sends Authorization: Bearer $CRON_SECRET automatically) ---
CRON_SECRET=                            # generate: openssl rand -hex 32

# --- Firebase client SDK (public web config for /admin Google sign-in; safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Cloudinary (PHOTO STORAGE ONLY — free tier: 25 pooled credits/month) ---
# Sign up at cloudinary.com (no credit card) → Dashboard → copy these three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=        # server-only; never prefix with NEXT_PUBLIC_

# --- Telegram alerts (dedicated ReVault bot via BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- App ---
APP_BASE_URL=https://revault-dm-bot.vercel.app
NODE_ENV=production

# --- Behaviour (safe defaults; override per environment) ---
PUBLISH_MODE=review                 # review | auto | dry_run
MAX_POSTS_PER_DAY=6
MIN_GAP_MINUTES=90
POSTING_WINDOW_START=12:00
POSTING_WINDOW_END=23:00
TimeZone=Asia/Karachi
MAX_LISTINGS_PER_SELLER_PER_DAY=5
PHOTO_DEBOUNCE_SECONDS=25
RETENTION_DAYS=30
CAPTION_CTA=dm                      # dm | site
COVER_SLIDE_ENABLED=false           # true only after /brand assets arrive
